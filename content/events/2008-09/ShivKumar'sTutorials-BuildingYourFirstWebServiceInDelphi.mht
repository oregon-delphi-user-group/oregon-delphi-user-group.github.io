      var attrib =3D attributes[i];
      if (attrib.name.indexOf("_") =3D=3D 0)
        paramNameValues +=3D attrib.name.substring(1, =
attrib.name.length) + "=3D" + attrib.value + "&";
    }=20
    if (paramNameValues.length > 0)
