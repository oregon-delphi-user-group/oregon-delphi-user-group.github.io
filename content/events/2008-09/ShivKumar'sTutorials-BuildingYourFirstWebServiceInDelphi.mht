    var i =3D 0;
    var ln =3D ctrl.childNodes.length;
    for (i =3D 0; i < ln; i++) {
      var childNode =3D ctrl.childNodes[i];
      if (!iterateDelegate(childNode, children))
        return;
      if (childNode.hasChildNodes())
        getChildControls(childNode, children, iterateDelegate);
    }
