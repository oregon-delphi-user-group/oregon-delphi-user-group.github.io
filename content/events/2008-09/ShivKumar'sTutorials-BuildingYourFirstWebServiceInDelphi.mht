  function getNameValuesOfControls(ctrlArray) {
    var data =3D "";
    var ln =3D ctrlArray.length;
    for (i =3D 0; i < ln; i ++ ) {
      var element =3D ctrlArray[i];
      var elementName =3D =
extractFieldNameFromASPNETStyleName(element.name);
      if (element.tagName =3D=3D "INPUT" && elementName !=3D =
"__VIEWSTATE" && elementName !=3D "__EVENTVALIDATION") {
        if (element.type =3D=3D "hidden" || element.type =3D=3D "text" =
|| element.type =3D=3D "password")
          data +=3D elementName + "=3D" + =
encodeURIComponent(element.value) + "&";
        else if ((element.type =3D=3D "radio" || element.type =3D=3D =
"checkbox") && element.checked)
          data +=3D elementName + "=3D" + element.value + "&";
      }
      else if (element.tagName =3D=3D "SELECT" && element.options.length =
!=3D 0)=20
        data +=3D elementName + "=3D" + =
element.options[element.selectedIndex].value + "&";
      else if (element.tagName =3D=3D "TEXTAREA")=20
        data +=3D elementName + "=3D" + =
encodeURIComponent(element.value) + "&";
