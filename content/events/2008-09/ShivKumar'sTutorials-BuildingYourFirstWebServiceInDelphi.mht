    var monthSepPos =3D dateStr.indexOf(dtSep);
    var daySepPos =3D dateStr.indexOf(dtSep, monthSepPos + 1);
    if (monthSepPos =3D=3D -1 || daySepPos =3D=3D -1 || daySepPos - =
monthSepPos =3D=3D 1) {
      errObj.msg =3D "Please Enter a Valid Date in the Format =
mm/dd/yyyy";
      return false;
    }
   =20
    var strMonth =3D dateStr.substring(0, monthSepPos);
    var strDay =3D dateStr.substring(monthSepPos + 1, daySepPos);
    var strYear =3D dateStr.substring(daySepPos + 1);
     =20
    var month =3D parseInt(strMonth);
    if (isNaN(month) || month < 1 || month > 12) {
      errObj.msg =3D "Please Enter a Valid Month Between 1 - 12";
      return false;
    }
    var year =3D parseInt(strYear);
    if (isNaN(year) || year < minYear || year > maxYear) {
