      function showPopupWindow(url, windowName, width, height) {
        var features =3D =
"toolbar=3D0,location=3D0,status=3D0,menubar=3D0,scrollbars=3D1,resizable=
=3D1,height=3D" + height + ",width=3D" + width;
        if (url.indexOf("?") =3D=3D -1)
          url +=3D "?tz=3D" + getTimeString();
        else
          url +=3D "&tz=3D" + getTimeString();
        popupWin =3D window.open(url, windowName, features, 0);
        popupWin.focus();
        return popupWin;
      }
     =20
      function getTimeString() {
        var d =3D new Date();
        return d.getHours().toString() + d.getMinutes().toString() + =
d.getSeconds().toString() + d.getMilliseconds().toString();
      }

      function urlEncode(url) {
        var encodedUrl =3D escape(url);
        encodedUrl =3D encodedUrl.replace(/\//g,"%2F");
        encodedUrl =3D encodedUrl.replace(/\?/g,"%3F");
        encodedUrl =3D encodedUrl.replace(/=3D/g,"%3D");
        encodedUrl =3D encodedUrl.replace(/&/g,"%26");
        encodedUrl =3D encodedUrl.replace(/@/g,"%40");
        return encodedUrl;
      }   =20
    </SCRIPT>

